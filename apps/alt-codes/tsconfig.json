{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "resolveJsonModule": true,
    // `node` is needed by two things that genuinely run in node rather than in
    // workerd: `+server.ts` reads process.env.PORT for the `prod` entry, and
    // src/og/render.spec.ts writes a rendered card to disk under vitest. Each
    // branch built green alone; only the merged tree needed this.
    "types": ["vite/client", "vike/types", "node"],
    "jsx": "react-jsx"
  },
  // `+server.ts` is in here deliberately: it is the Worker's entry, and Vike's
  // `Server` type is what enforces that it exports a `fetch`. Left out, a Worker
  // that 500s on every request typechecks clean.
  "include": ["src", "pages", "+server.ts"]
}
